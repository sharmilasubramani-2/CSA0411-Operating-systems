#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <string.h>

int main()
{
    key_t key = 1234;

    int shmid = shmget(key, 1024, 0666 | IPC_CREAT);

    if (shmid < 0)
    {
        printf("Shared memory creation failed.\n");
        return 1;
    }

    char *str = (char *)shmat(shmid, NULL, 0);

    strcpy(str, "Operating Systems Lab");

    printf("Data written into shared memory: %s\n", str);

    shmdt(str);

    return 0;
}
